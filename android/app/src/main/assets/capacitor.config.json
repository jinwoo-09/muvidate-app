{
	"appId": "com.muvidate.app",
	"appName": "MuviDate",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": false
	},
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false,
		"backgroundColor": "#0a0a0a"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"launchAutoHide": false,
			"backgroundColor": "#0a0a0a",
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false
		},
		"Keyboard": {
			"resize": "native",
			"style": "DARK"
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0a0a0a",
			"overlaysWebView": true
		},
		"SystemBars": {
			"insetsHandling": "css",
			"style": "DARK",
			"hidden": false
		}
	}
}
